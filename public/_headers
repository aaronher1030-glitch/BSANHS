/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; img-src 'self' https://lh3.googleusercontent.com https://drive.google.com data:; frame-src https://docs.google.com; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src 'self'; base-uri 'none'; object-src 'none'; form-action 'self'

/api/*
  Cache-Control: public, max-age=60, s-maxage=300, stale-while-revalidate=86400

/assets/*
  Cache-Control: public, max-age=31536000, immutable
